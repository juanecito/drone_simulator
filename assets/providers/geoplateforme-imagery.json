{
  "schemaVersion": 1,
  "key": "geoplateforme-imagery",
  "name": "Géoplateforme imagery (IGN France, cartes.gouv.fr)",
  "kind": "imagery",
  "protocol": "wmts",
  "x-note": "WMTS of data.geopf.fr in the PM_0_19 tile matrix set (EPSG:3857, the GoogleMapsCompatible grid: same scale and origin); layers, styles, formats and zoom levels checked against the live GetCapabilities on 2026-11-21. No key, no rate limit on the WMTS (cartes.gouv.fr/cgu). Licence Ouverte 2.0 from each dataset's catalogue record. Coverage limited to metropolitan France and Corsica (the overseas territories are served too, but one rectangle cannot hold them); recheck before release.",
  "urlTemplate": "https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER={dataset}&STYLE=normal&FORMAT=image/jpeg&TILEMATRIXSET=PM_0_19&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}",
  "format": "image/jpeg",
  "crs": "EPSG:3857",
  "tileSizePx": 256,
  "defaultDataset": "ORTHOIMAGERY.ORTHOPHOTOS",
  "datasets": [
    { "id": "ORTHOIMAGERY.ORTHOPHOTOS", "name": "Aerial photographs (BD ORTHO, France)",
      "minZoom": 0, "maxZoom": 19,
      "coverage": { "west": -5.2, "south": 41.3, "east": 9.6, "north": 51.1 },
      "attribution": "BD ORTHO® © IGN" },
    { "id": "GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2", "name": "Plan IGN map (France)",
      "urlTemplate": "https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER={dataset}&STYLE=normal&FORMAT=image/png&TILEMATRIXSET=PM_0_19&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}",
      "minZoom": 0, "maxZoom": 19,
      "coverage": { "west": -5.2, "south": 41.3, "east": 9.6, "north": 51.1 },
      "attribution": "Plan IGN © IGN" }
  ],
  "requiresKey": false,
  "attribution": "Imagery: © IGN, Géoplateforme (cartes.gouv.fr), Licence Ouverte 2.0",
  "licence": "Licence Ouverte / Open Licence 2.0 (Etalab): free use, including commercial, with attribution.",
  "termsUrl": "https://cartes.gouv.fr/cgu",
  "allowCache": true,
  "maxAgeDays": 180,
  "rateLimitRps": 20,
  "dailyCallLimit": null,
  "maxConcurrent": 4,
  "insecureHttp": false,
