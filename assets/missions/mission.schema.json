            "land",
            "gateCourse",
            "deliver",
            "inspect",
            "survey",
            "returnHome",
            "park"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "reachAltitude"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/objReachAltitude"
          }
        },
        {
