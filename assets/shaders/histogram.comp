//
// Luminance histogram of the resolved HDR image for auto exposure (FR-GFX-08c). Bin 0 holds
// black pixels; bins 1–255 cover log2(L) from kMinLog2 to kMaxLog2 (absolute cd/m²).

#include "common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 4) uniform sampler2D t_hdr;

const float kMinLog2 = -16.0;
const float kMaxLog2 = 18.0;

shared uint s_bins[256];

void main() {
    uint i = gl_LocalInvocationIndex;
    s_bins[i] = 0u;
    barrier();
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(p, textureSize(t_hdr, 0)))) {
        float l = luminance(texelFetch(t_hdr, p, 0).rgb) / max(e_exposure, 1e-12);
        uint bin = 0u;
        if (l > exp2(kMinLog2)) {
            float f = (log2(l) - kMinLog2) / (kMaxLog2 - kMinLog2);
            bin = uint(clamp(f * 254.0 + 1.0, 1.0, 255.0));
        }
        atomicAdd(s_bins[bin], 1u);
    }
    barrier();
    atomicAdd(e_histogram[i], s_bins[i]);
}
