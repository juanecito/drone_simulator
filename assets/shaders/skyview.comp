//
// Sky-view LUT (Hillaire 2020, §5.3): sky luminance (cd/m²) seen from the camera for every
// direction, lit by the Sun and the Moon. Azimuth is absolute (from north), so both lights
// share one table.

#include "common.glsl"
#include "atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba32f) uniform writeonly image2D o_lut;

vec3 lightContribution(vec3 pos, float h, vec3 dir, vec4 dirLux, vec4 colorRadius,
                       Medium m) {
    vec3 l = dirLux.xyz;
    float muL = dot(pos, l) / h;
    vec3 t = transmittanceToLight(h, muL, colorRadius.w);
    float c = dot(dir, l);
    vec3 single = (m.rayleigh * rayleighPhase(c) + m.mie * miePhase(c)) * t;
    vec3 multi = (m.rayleigh + m.mie) * multiScattering(h, muL);
    return (single + multi) * colorRadius.rgb * dirLux.w;
}

vec3 groundLight(vec3 pos, float h, vec4 dirLux, vec4 colorRadius) {
    float muL = dot(pos, dirLux.xyz) / h;
    return transmittanceToLight(h, muL, colorRadius.w) * max(muL, 0.0) * colorRadius.rgb *
           dirLux.w;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(o_lut);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    float r = cameraRadius();
    vec3 dir = skyViewDirection(uv, r);
    float mu = dir.y;
    bool ground = rayHitsGround(r, mu);
    float tMax = ground ? distanceToGround(r, mu) : distanceToTop(r, mu);

    const int kSteps = 40;
    vec3 origin = vec3(0.0, r, 0.0);
    vec3 luminance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    float tPrev = 0.0;
    for (int k = 0; k < kSteps; ++k) {
        // Quadratic distribution: short steps near the camera.
        float f = (float(k) + 1.0) / float(kSteps);
        float t = tMax * f * f;
        float dt = t - tPrev;
        float tMid = 0.5 * (t + tPrev);
        tPrev = t;
        vec3 pos = origin + tMid * dir;
        float h = length(pos);
        Medium m = sampleMedium(h - bottomRadius());
        vec3 ext = max(m.extinction, vec3(1e-7));
        vec3 sampleT = exp(-m.extinction * dt);
        vec3 s = lightContribution(pos, h, dir, u_sunDirLux, u_sunColorRadius, m) +
                 lightContribution(pos, h, dir, u_moonDirLux, u_moonColorRadius, m);
        luminance += throughput * (s - s * sampleT) / ext;
        throughput *= sampleT;
    }
    if (ground) {
        vec3 pos = origin + tMax * dir;
        float h = length(pos);
        vec3 e = groundLight(pos, h, u_sunDirLux, u_sunColorRadius) +
                 groundLight(pos, h, u_moonDirLux, u_moonColorRadius);
        luminance += throughput * e * a_ground.rgb / PI;
    }
    imageStore(o_lut, p, vec4(luminance, 1.0));
}
