// Transmittance LUT: transmittance from (r, mu) to the top of the atmosphere.

#include "common.glsl"
#include "atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba32f) uniform writeonly image2D o_lut;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(o_lut);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    float r;
    float mu;
    transmittanceParams(uv, r, mu);
    float d = distanceToTop(r, mu);
    const int kSteps = 64;
    float dt = d / float(kSteps);
    vec3 depth = vec3(0.0);
    for (int i = 0; i < kSteps; ++i) {
        float t = (float(i) + 0.5) * dt;
        float ri = sqrt(r * r + t * t + 2.0 * r * mu * t);
        depth += sampleMedium(ri - bottomRadius()).extinction * dt;
    }
    imageStore(o_lut, p, vec4(exp(-depth), 1.0));
}
