# The package is distributed by the project itself, not through the Debian archive.

# FR-PKG-03: the program is installed as an add-on package in /opt/drone_simulator.
drone-simulator: dir-or-file-in-opt [opt/*]

# FR-PKG-02 / FR-PKG-05: section "games", with the command in /usr/bin (a symlink into /opt),
